
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимость();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	МассивОчищаемыхРеквизитов = Новый Массив;
	ТипКонтрагента = РаботаСДокументамиСервер.ПолучитьТикКонтрагента(Объект.Контрагент);
	
	Если ТипКонтрагента = ПредопределенноеЗначение("Перечисление.ТипыКонтрагентов.Клиент") И ЗначениеЗаполнено(Объект.Договор) Тогда
		МассивОчищаемыхРеквизитов.Добавить("Договор");
		ТекстВопроса = "При изменении реквизита ""Контрагент"" на контрагента с типом ""Клиент"" будут очищены следующие данные:
		| - Договор
		| Продолжить?";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивОчищаемыхРеквизитов) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииКонтрагента", ЭтаФорма, МассивОчищаемыхРеквизитов);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,,"Внимание!");
	Иначе
		Контрагент = Объект.Контрагент;
		УстановитьВидимость();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.РасчетСуммыТЧЦенаКоличество(Элементы.Товары.ТекущиеДанные);
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.РасчетСуммыТЧЦенаКоличество(Элементы.Товары.ТекущиеДанные);
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.РасчетСуммыТЧЦенаКоличество(Элементы.Услуги.ТекущиеДанные);
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.РасчетСуммыТЧЦенаКоличество(Элементы.Услуги.ТекущиеДанные);
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ДанныеСтрокиТЧ = Элементы.Товары.ТекущиеДанные;
	ДанныеСтрокиТЧ.Цена = РаботаСДокументамиСервер.ПолучитьЦенуРеализацииНаДату(ДанныеСтрокиТЧ.Номенклатура, Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)
	
	ДанныеСтрокиТЧ = Элементы.Услуги.ТекущиеДанные;
	ДанныеСтрокиТЧ.Цена = РаботаСДокументамиСервер.ПолучитьЦенуРеализацииНаДату(ДанныеСтрокиТЧ.Услуга, Объект.Дата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимость()
	
	ТипКонтрагента = РаботаСДокументамиСервер.ПолучитьТикКонтрагента(Объект.Контрагент);
	ЭтоПокупатель = (ТипКонтрагента = ПредопределенноеЗначение("Перечисление.ТипыКонтрагентов.Покупатель"));
	Элементы.Договор.Видимость = ЭтоПокупатель;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОбИзмененииКонтрагента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Для Каждого Реквизит Из ДополнительныеПараметры Цикл
			Объект[Реквизит] = Неопределено;
		КонецЦикла;
		УстановитьВидимость();
	Иначе
		Объект.Контрагент = Контрагент;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

