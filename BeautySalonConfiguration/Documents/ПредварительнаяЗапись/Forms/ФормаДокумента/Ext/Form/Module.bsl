
#Область ОбработчикСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.РасчетСуммыТЧЦенаКоличество(Элементы.Услуги.ТекущиеДанные);
	ПересчитатьСуммуДокумента();
	РассчитатьВремяОкончанияЗаписи();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	
	РаботаСДокументамиКлиент.РасчетСуммыТЧЦенаКоличество(Элементы.Услуги.ТекущиеДанные);
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)
	
	ДанныеСтрокиТЧ = Элементы.Услуги.ТекущиеДанные;
	Если ЗначениеЗаполнено(ДанныеСтрокиТЧ.Услуга) Тогда
		ДанныеСтрокиТЧ.Цена = РаботаСДокументамиСервер.ПолучитьЦенуРеализацииНаДату(ДанныеСтрокиТЧ.Услуга, Объект.Дата);
	Иначе
		ДанныеСтрокиТЧ.Цена = 0;
	КонецЕсли;
	
	РассчитатьВремяОкончанияЗаписи();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПересчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьВремяОкончанияЗаписи()
	
	ОбщееВремяВСекундах = 0;
	
	Для Каждого СтрокаУслуг Из Объект.Услуги Цикл
		ДлительностьУслугиВСекундах = РаботаСДокументамиСервер.ПолучитьДлительностьУслуги(СтрокаУслуг.Услуга) * 60;
		ОбщееВремяВСекундах = ОбщееВремяВСекундах + (ДлительностьУслугиВСекундах * СтрокаУслуг.Количество);
	КонецЦикла;
	
	Объект.ДатаОкончанияЗаписи = Объект.ДатаЗаписи + ОбщееВремяВСекундах;
	
КонецПроцедуры

#КонецОбласти