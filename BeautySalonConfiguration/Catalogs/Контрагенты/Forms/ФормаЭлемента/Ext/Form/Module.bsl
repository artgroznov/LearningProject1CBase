
#Область ОбработчикСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьИЗаголовокНаименования();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы 

&НаКлиенте
Процедура ТипКонтрагентаПриИзменении(Элемент)
	
	МассивОчищаемыхРеквизитов = Новый Массив;
	
	Если НЕ Объект.ТипКонтрагента = ПредопределенноеЗначение("Перечисление.ТипыКонтрагентов.Клиент") И 
		(ЗначениеЗаполнено(Объект.ДатаРожденияКлиента) ИЛИ ЗначениеЗаполнено(Объект.ПолКлиента)) Тогда
		МассивОчищаемыхРеквизитов.Добавить("ДатаРожденияКлиента");
		МассивОчищаемыхРеквизитов.Добавить("ПолКлиента");
		ТекстВопроса = "При изменении реквизита ""Тип контрагента"" на ""Поставщик"" или ""Покупатель"" будут очищены следующие данные:
		| - Дата рождения клиента
		| - Пол клиента
		| Продолжить?";
	ИначеЕсли Объект.ТипКонтрагента = ПредопределенноеЗначение("Перечисление.ТипыКонтрагентов.Клиент") И ЗначениеЗаполнено(Объект.Договор) Тогда
		МассивОчищаемыхРеквизитов.Добавить("Договор");
		ТекстВопроса = "При изменении реквизита ""Тип контрагента"" на ""Клиент"" будут очищены следующие данные:
		| - Договор
		| Продолжить?";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивОчищаемыхРеквизитов) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииТипаКлинта", ЭтаФорма, МассивОчищаемыхРеквизитов);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,,"Внимание!");
	Иначе
		ТипКонтрагента = Объект.ТипКонтрагента;
		УстановитьВидимостьИЗаголовокНаименования();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимостьИЗаголовокНаименования()
	
	ЭтоКлиент = (Объект.ТипКонтрагента = ПредопределенноеЗначение("Перечисление.ТипыКонтрагентов.Клиент"));
	
	Если ЭтоКлиент Тогда
		Элементы.Наименование.Заголовок = "ФИО";
	Иначе
		Элементы.Наименование.Заголовок = "Наименование";
	КонецЕсли;
	
	Элементы.ДатаРожденияКлиента.Видимость = ЭтоКлиент;
	Элементы.ПолКлиента.Видимость = ЭтоКлиент;
	Элементы.Договор.Видимость = НЕ ЭтоКлиент;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОбИзмененииТипаКлинта(Результат, ДополнительныеПараметры) Экспорт
		
	Если Результат = КодВозвратаДиалога.Да Тогда
		Для Каждого Реквизит Из ДополнительныеПараметры Цикл
			Объект[Реквизит] = Неопределено;
		КонецЦикла;
		УстановитьВидимостьИЗаголовокНаименования();
	Иначе
		Объект.ТипКонтрагента = ТипКонтрагента;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти