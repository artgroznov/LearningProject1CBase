
#Область ОбработчикСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимость();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура БессрочныйПриИзменении(Элемент)
	
	МассивОчищаемыхРеквизитов = Новый Массив;
	
	Если Объект.Бессрочный = Истина И ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		МассивОчищаемыхРеквизитов.Добавить("ДатаОкончания");
		ТекстВопроса = "При изменении реквизита ""Бессточный"" на ""Истина"" будут очищены следующие данные:
		| - ДатаОкончания
		| Продолжить?";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивОчищаемыхРеквизитов) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииБессрочностиДоговора", ЭтаФорма, МассивОчищаемыхРеквизитов);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,,"Внимание!");
	Иначе
		Бессрочный = Объект.Бессрочный;
		УстановитьВидимость();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерПриИзменении(Элемент)
	
	СформироватьНаименование();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	СформироватьНаименование();
	
КонецПроцедуры

#конецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СформироватьНаименование()
	
	Если ЗначениеЗаполнено(Объект.ДатаНачала) И ЗначениеЗаполнено(Объект.Номер) Тогда
		Объект.Наименование = СтрШаблон("№%1 от %2 г.", Объект.Номер, Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy"));
	ИначеЕсли ЗначениеЗаполнено(Объект.Номер) Тогда
		Объект.Наименование = СтрШаблон("№%1", Объект.Номер);
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Объект.Наименование = СтрШаблон("От %1 г.", Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	
	ПризнакБессрочности = Объект.Бессрочный;
	
	Элементы.ДатаОкончания.Видимость = НЕ ПризнакБессрочности;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОбИзмененииБессрочностиДоговора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Для Каждого Реквизит Из ДополнительныеПараметры Цикл
			Объект[Реквизит] = '00010101';
		КонецЦикла;
		УстановитьВидимость();
	Иначе
		Объект.Бессрочный = Бессрочный;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

