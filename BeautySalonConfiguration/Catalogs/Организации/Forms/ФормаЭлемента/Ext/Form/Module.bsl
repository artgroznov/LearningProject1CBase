
#Область ОбработчикСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ТипОрганизации = ПредопределенноеЗначение("Перечисление.ТипыОрганизаций.ЮридическоеЛицо") И СтрДлина(Объект.ИНН) <> 10 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Неверная длина строки для такого типа организации'"), , "ИНН", "Объект", Отказ);
	ИначеЕсли Объект.ТипОрганизации = ПредопределенноеЗначение("Перечисление.ТипыОрганизаций.ИндивидуальныйПредприниматель") 
		И СтрДлина(Объект.ИНН) <> 12 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Неверная длина строки для такого типа организации'"), , "ИНН", "Объект", Отказ);
	КонецЕсли;		
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТипОрганизацииПриИзменении(Элемент)
	
	МассивОчищаемыхРеквизитов = Новый Массив;
	
	Если Объект.ТипОрганизации = ПредопределенноеЗначение("Перечисление.ТипыОрганизаций.ИндивидуальныйПредприниматель") 
		И ЗначениеЗаполнено(Объект.ГлавныйБухгалтер) Тогда
		МассивОчищаемыхРеквизитов.Добавить("ГлавныйБухгалтер");
		ТекстВопроса = "При изменении реквизита ""Тип организации"" на ""Индивидуальный предприниматель"" будут очищены следующие данные:
		| - Главный бухгалтер
		| Продолжить?";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивОчищаемыхРеквизитов) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииТипаОрганизации", ЭтаФорма, МассивОчищаемыхРеквизитов);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,,"Внимание!");
	Иначе
		ТипОрганизиции = Объект.ТипОрганизации;
		УстановитьВидимость();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимость()
	
	ЭтоЮрЛицо = (Объект.ТипОрганизации = ПредопределенноеЗначение("Перечисление.ТипыОрганизаций.ЮридическоеЛицо"));
	
	Элементы.ГлавныйБухгалтер.Видимость = ЭтоЮрЛицо;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОбИзмененииТипаОрганизации(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Для Каждого Реквизит Из ДополнительныеПараметры Цикл
			Объект[Реквизит] = Неопределено;
		КонецЦикла;
		УстановитьВидимость();
	Иначе
		Объект.ТипОрганизации = ТипОрганизиции;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти
